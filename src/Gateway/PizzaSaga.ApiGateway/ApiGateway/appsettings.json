{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Yarp": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj} {NewLine}{Exception}"
        }
      }
    ]
  },

  "AllowedHosts": "*",


  // В YARP вся магия настройки обратного прокси держится на двух главных китах: Routes (Маршруты) и Clusters (Кластеры)
  "ReverseProxy": {

    // Маршруты (Правила маршрутизации). Здесь мы описываем, какие входящие запросы мы ловим и куда их нужно отправить.
    "Routes": {

      // --- Swagger Routes ---
      "swagger-auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          // Ловим входящий запрос: /swagger/auth/v1/swagger.json
          "Path": "/swagger/auth/{**catch-all}"
        },
        "Transforms": [
          // Отправляющим в auth-api срез: /swagger/v1/swagger.json
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },
      "swagger-catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          // Ловим входящий запрос: /swagger/catalog/v1/swagger.json
          "Path": "/swagger/catalog/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },
      "swagger-order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          // Ловим входящий запрос: /swagger/order/v1/swagger.json
          "Path": "/swagger/order/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },

      // Auth service
      "auth-route": {
        // Связующее звено. Эта строка говорит: «Если запрос подошел под это правило, отправь его в кластер с именем auth-cluster».
        "ClusterId": "auth-cluster",
        // "Match" — условия, при которых правило срабатывает.
        "Match": {
          // Шлюз будет перехватывать все запросы, которые начинаются с /api/auth
          // {catch-all} (его еще называют wildcard) означает: «и всё, что идет дальше». YARP возьмет этот «хвост» и передаст его конечному сервису.
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      // Catalog service
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/v1/catalogs/{**catch-all}"
        }
      },
      // Order service
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/v1/orders/{**catch-all}"
        }
      }

    },

    // Кластеры (Целевые группы). Здесь мы описываем, кто именно будет обрабатывать запросы. Кластер — это группа серверов (или один сервер), выполняющих одну и ту же задачу.
    "Clusters": {
      "auth-cluster": {
        // "Destinations" — список конкретных физических или логических адресов (точек назначения) внутри этого кластера. 
        // Если бы у нас было три копии сервиса заказов, мы бы описали здесь destination1, destination2 и destination3.
        "Destinations": {
          // "destination1" — техническое имя конкретного сервера в списке.
          // "Address": "http://auth-api" — адрес, на который YARP перешлет запрос.
          "destination1": {
            "Address": "http://auth-api"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://catalog-api"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://order-api"
          }
        }
      }
    }
  }
}
